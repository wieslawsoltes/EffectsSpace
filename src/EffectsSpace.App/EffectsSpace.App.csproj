<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-browserwasm;net10.0-desktop</TargetFrameworks>
    <TargetFrameworks Condition="'$(EffectsSpaceDesktopOnly)' == 'true'">net10.0-desktop</TargetFrameworks>
    <OutputType>Exe</OutputType><UnoSingleProject>true</UnoSingleProject><UnoFeatures>SkiaRenderer;</UnoFeatures>
    <ApplicationTitle>EffectsSpace</ApplicationTitle><ApplicationId>io.github.wieslawsoltes.effectsspace</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion><ApplicationVersion>1</ApplicationVersion><ApplicationPublisher>EffectsSpace contributors</ApplicationPublisher>
    <Description>Independent motion-design and compositing workbench.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><IsPackable>false</IsPackable>
    <UnoDisableHotDesign>true</UnoDisableHotDesign><UnoDisableMCPSupport>true</UnoDisableMCPSupport>
    <RunAOTCompilation>false</RunAOTCompilation><WasmShellGenerateAOTProfile>false</WasmShellGenerateAOTProfile>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../EffectsSpace.Workbench/EffectsSpace.Workbench.csproj" /></ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-browserwasm'">
    <EmbeddedResource Include="Platforms/WebAssembly/WasmScripts/Storage.js" />
    <TrimmerRootAssembly Include="EffectsSpace.Core" />
    <TrimmerRootAssembly Include="EffectsSpace.Documents" />
  </ItemGroup>
</Project>
